-            val = parse_object(p);
-            break;
-
         case XCDN_TOK_LBRACKET:
-            val = parse_array(p);
+            if (p->depth >= XCDN_MAX_DEPTH) {
+                xcdn_token_free(&t);
+                p->err = xcdn_error_new(XCDN_ERR_MESSAGE,
