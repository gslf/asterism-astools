@@ -88,10 +88,17 @@ static xcdn_span_t parser_span(const xcdn_lexer_t *lex) {
 
 /* ── Parser state ─────────────────────────────────────────────────────── */
 
+/* Nesting cap: hostile input (e.g. a compromised astools tool emitting
+ * hundreds of thousands of '[') would otherwise overflow the C stack via
+ * the parse_value -> parse_object/array -> parse_node -> parse_value
+ * recursion. 512 is far beyond any legitimate document. */
+#define XCDN_MAX_DEPTH 512
+
 typedef struct {
     xcdn_lexer_t  lex;
     xcdn_token_t  look;
     int           has_look;
+    int           depth;
     xcdn_error_t  err;
 } parser_t;
 
@@ -99,6 +106,7 @@ static void parser_init(parser_t *p, const char *src, size_t src_len) {
     xcdn_lexer_init(&p->lex, src, src_len);
     memset(&p->look, 0, sizeof(p->look));
     p->has_look = 0;
+    p->depth = 0;
     p->err = xcdn_error_none();
 }
 
